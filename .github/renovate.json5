{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "group:monorepos",
    "helpers:pinGitHubActionDigests",
    ":semanticPrefixFixDepsChoreOthers",
    ":dependencyDashboard",
  ],

  // Renovate currently targets only the development branch. Add reviewed
  // release-branch patterns here when the Buildish release process is defined.
  baseBranchPatterns: [
    "main",
  ],

  dockerfile: {
    // Update all dockerfiles
    "ignorePaths": []
  },

  // `main` is accepted only for the pre-first-release bootstrap. A Release
  // Tooling release update replaces it with the release tag's commit digest.
  // Renovate opens an ordinary PR; it does not merge the change automatically.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github\\/workflows\\/.+\\.ya?ml$/"],
      matchStrings: [
        "BUILDISH_RELEASE_TOOLING_REF: (?<currentDigest>main|[a-f0-9]{40}) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>.+?))? currentValue=(?<currentValue>.+?)\\s",
      ],
      matchStringsStrategy: "any",
    },
  ],

  packageRules: [
    // Check supported dependency sources for updates without automatically merging them.
    {
      matchManagers: [
        "gradle", "gradle-wrapper",
        "dockerfile", "devcontainer", "docker-compose",
        "github-actions"],
      automerge: false, // just be explicit (false is the default)
    },
  ],

  // Max 50 PRs in total, 5 per hour.
  // Renovate rebases PRs automatically when the renovate bot "visits" (scans) the repo, hence the hourly and
  // concurrent PRs limit.
  prConcurrentLimit: 50,
  prHourlyLimit: 5,
}
